<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Même groupe de trousseau que l'app : les widgets n'ont pas accès au
	  réseau local, ils y lisent le dernier état transmis par l'app et y
	  déposent les actions déclenchées depuis l'écran d'accueil.

	  Volontairement pas d'App Group, qui exigerait un compte Apple payant.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.trackpadhub.shared</string>
	</array>
</dict>
</plist>
