<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Même groupe de trousseau que l'app hôte : l'extension y lit le jeton
	  d'appairage et l'identité de l'appareil.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.trackpadhub.shared</string>
	</array>
</dict>
</plist>
